{
  "manifest_version": 3,
  "name": "Meetron Controls",
  "version": "0.8.1",
  "description": "Local controls and status for the Meetron bridge.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "https://meet.google.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Meetron",
    "default_popup": "popup.html"
  }
}
